# Managed by Ansible - DO NOT EDIT MANUALLY

network:
  version: 2

  tunnels:
{% for vni in vxlan_ids %}
    vx{{ vni }}:
      mode: vxlan
      id: {{ vni }}
      link: {{ vxlan_underlay_iface }}
      local: {{ vxlan_underlay_ip }}
      port: {{ vxlan_port }}
{% endfor %}

  bridges:
{% for vni in vxlan_ids %}
    br-vx{{ vni }}:
      interfaces:
        - vx{{ vni }}
      addresses:
        - {{ vxlan_overlay_ips[inventory_hostname][(vni|string)] | default('192.168.99.99/24') }}
      parameters:
        stp: false
{% endfor %}
